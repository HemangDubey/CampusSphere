generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users and roles
enum Role {
  STUDENT
  FACULTY
  EVENT_ORGANIZER
  HEALTHCARE_ADMIN
  CAMPUS_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(STUDENT)
  status         UserStatus @default(ACTIVE)
  registrationNo String?
  department     String?
  yearOfStudy    Int?
  phone          String?
  bio            String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sessions            Session[]
  resetTokens         PasswordResetToken[]
  eventRegistrations  EventRegistration[]
  organizedEvents     Event[]                 @relation("EventOrganizer")
  favorites           FavoriteDestination[]
  recentViews         RecentDestinationView[]
  trips               Trip[]
  tripMemberships     TripMember[]
  resourceBookmarks   ResourceBookmark[]
  resourceViews       ResourceView[]
  readingList         ReadingListItem[]
  serviceRequests     ServiceRequest[]        @relation("RequestRequester")
  assignedRequests    ServiceRequest[]        @relation("RequestAssignee")
  leaveRequests       LeaveRequest[]          @relation("LeaveStudent")
  leaveToReview       LeaveRequest[]          @relation("LeaveReviewer")
  appointments        Appointment[]
  courseRegistrations CourseRegistration[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  gameScores          GameScore[]
  posts               CommunityPost[]
  roleRequests        RoleRequest[]           @relation("RoleRequester")
  roleDecisions       RoleRequest[]           @relation("RoleDecider")
  comments            CommunityComment[]
  postLikes           PostLike[]
  postBookmarks       PostBookmark[]
  clubMemberships     ClubMember[]
  clubsCreated        Club[]
  reportsFiled        ContentReport[]         @relation("ReportReporter")
  reportsResolved     ContentReport[]         @relation("ReportResolver")
}

// One row per signed-in browser. The JWT in the HTTP-only cookie carries this id;
// revoking the row (logout, password reset, suspension) invalidates the session server-side.
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Only a SHA-256 hash of the reset token is stored; tokens are single use and expire.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------- cross-cutting
enum NotificationType {
  EVENT
  REQUEST
  LEAVE
  APPOINTMENT
  COMMUNITY
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Append-only record of important administrative actions. Never stores secrets.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

enum SubjectType {
  SERVICE_REQUEST
  LEAVE
  APPOINTMENT
}

// Status history shared by the three approval-style workflows.
model StatusHistory {
  id          String      @id @default(uuid())
  subjectType SubjectType
  subjectId   String
  actorId     String?
  actorName   String?
  fromStatus  String?
  toStatus    String
  note        String?
  createdAt   DateTime    @default(now())

  @@index([subjectType, subjectId, createdAt])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  body        String
  status      AnnouncementStatus @default(DRAFT)
  isDemo      Boolean            @default(false)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// ---------------------------------------------------------------- events
enum EventCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  WORKSHOP
  SYMPOSIUM
}

enum EventMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id                   String        @id @default(uuid())
  title                String
  description          String
  category             EventCategory
  mode                 EventMode     @default(IN_PERSON)
  status               EventStatus   @default(PUBLISHED)
  startsAt             DateTime
  endsAt               DateTime?
  venue                String
  onlineLink           String?
  schedule             String?
  eligibility          String?
  instructions         String?
  organizerId          String?
  organizer            User?         @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  organizerName        String?
  coverImage           String?
  capacity             Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  fee                  Int           @default(0)
  cancelReason         String?
  isDemo               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  registrations EventRegistration[]

  @@index([startsAt])
  @@index([category])
  @@index([status])
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

model EventRegistration {
  id             String             @id @default(uuid())
  referenceNo    String             @unique
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status         RegistrationStatus @default(REGISTERED)
  fullName       String?
  registrationNo String?
  email          String?
  department     String?
  yearOfStudy    Int?
  teamSize       Int?
  track          String?
  answers        Json?
  attended       Boolean            @default(false)
  attendedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())

  @@unique([userId, eventId])
  @@index([eventId, status])
}

// ---------------------------------------------------------------- travel
enum DestinationType {
  HERITAGE
  NATURE
  SPIRITUAL
  BEACH
  CITY
}

enum BudgetCategory {
  BUDGET
  MODERATE
  PREMIUM
}

model Destination {
  id              String          @id @default(uuid())
  slug            String          @unique
  name            String
  region          String
  type            DestinationType
  budget          BudgetCategory
  summary         String
  description     String
  budgetMinInr    Int
  budgetMaxInr    Int
  recommendedDays Int
  distanceKm      Int?
  popularity      Int             @default(0)
  bestTime        String?
  imageUrl        String?
  gallery         String[]
  tips            String[]
  activities      String[]
  itineraryIdeas  Json?
  published       Boolean         @default(true)
  isDemo          Boolean         @default(true)

  favorites FavoriteDestination[]
  views     RecentDestinationView[]
  tripItems TripItem[]
  trips     Trip[]

  @@index([type])
  @@index([budget])
}

model FavoriteDestination {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, destinationId])
}

model RecentDestinationView {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  viewedAt      DateTime    @default(now())

  @@id([userId, destinationId])
}

model Trip {
  id            String       @id @default(uuid())
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  startDate     DateTime?    @db.Date
  endDate       DateTime?    @db.Date
  budgetInr     Int?
  notes         String?
  shareToken    String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items   TripItem[]
  members TripMember[]

  @@index([ownerId])
}

model TripItem {
  id            String       @id @default(uuid())
  tripId        String
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position      Int
  dayNumber     Int          @default(1)
  title         String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  estCostInr    Int          @default(0)
  notes         String?

  @@index([tripId, position])
}

enum TripRole {
  EDITOR
  VIEWER
}

model TripMember {
  tripId String
  trip   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   TripRole @default(EDITOR)

  @@id([tripId, userId])
}

// ---------------------------------------------------------------- campus resources and service requests
enum ResourceKind {
  DEPARTMENT
  LIBRARY
  FACILITY
  SUPPORT
  LINK
  ORGANIZATION
  CLUB
  SERVICE
}

enum ResourceStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

model ResourceCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  resources   Resource[]
}

model Resource {
  id                String            @id @default(uuid())
  kind              ResourceKind
  categoryId        String?
  category          ResourceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title             String
  summary           String
  details           String?
  author            String?
  status            ResourceStatus    @default(AVAILABLE)
  eligibility       String?
  instructions      String?
  requiredDocuments String[]
  contactInfo       String?
  imageUrl          String?
  acceptsRequests   Boolean           @default(false)
  formFields        Json?
  published         Boolean           @default(true)
  featured          Boolean           @default(false)
  accessUrl         String?
  tags              String[]
  publisher         String?
  publishedYear     Int?
  isDemo            Boolean           @default(true)
  createdAt         DateTime          @default(now())

  views       ResourceView[]
  bookmarks   ResourceBookmark[]
  readingList ReadingListItem[]
  requests    ServiceRequest[]

  @@index([kind])
}

model ResourceBookmark {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, resourceId])
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  DONE
}

// Last time a signed-in user opened a resource: powers "recently viewed" and engagement counts.
model ResourceView {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  @@id([userId, resourceId])
  @@index([userId, viewedAt])
}

model ReadingListItem {
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  status     ReadingStatus @default(WANT_TO_READ)
  notes      String?
  progress   Int?
  collection String?
  position   Int           @default(0)
  addedAt    DateTime      @default(now())

  @@id([userId, resourceId])
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

model ServiceRequest {
  id           String        @id @default(uuid())
  referenceNo  String        @unique
  requesterId  String
  requester    User          @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  data         Json
  status       RequestStatus @default(SUBMITTED)
  assigneeId   String?
  assignee     User?         @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt        DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([requesterId])
  @@index([status, dueAt])
}

// ---------------------------------------------------------------- healthcare (demonstration)
model HealthService {
  id           String           @id @default(uuid())
  name         String
  category     String
  description  String
  published    Boolean          @default(true)
  isDemo       Boolean          @default(true)
  providers    HealthProvider[]
  appointments Appointment[]
}

model HealthProvider {
  id           String        @id @default(uuid())
  serviceId    String
  service      HealthService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  speciality   String
  bio          String?
  published    Boolean       @default(true)
  isDemo       Boolean       @default(true)
  slots        HealthSlot[]
  appointments Appointment[]
}

enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED
}

model HealthSlot {
  id          String         @id @default(uuid())
  providerId  String
  provider    HealthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  status      SlotStatus     @default(OPEN)
  appointment Appointment?

  @@unique([providerId, startsAt])
  @@index([startsAt, status])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
  REJECTED
}

// A request record in this demonstration app. Nothing is sent to a real clinic or hospital.
model Appointment {
  id          String            @id @default(uuid())
  referenceNo String            @unique
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId   String
  service     HealthService     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  providerId  String?
  provider    HealthProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  slotId      String?           @unique
  slot        HealthSlot?       @relation(fields: [slotId], references: [id], onDelete: SetNull)
  patientName String
  phone       String
  reason      String
  status      AppointmentStatus @default(REQUESTED)
  adminNote   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------- leave and approvals
enum LeaveCategory {
  MEDICAL
  PERSONAL
  FAMILY
  ACADEMIC
  OTHER
}

enum LeaveStatus {
  SUBMITTED
  INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

model LeaveRequest {
  id           String        @id @default(uuid())
  referenceNo  String        @unique
  studentId    String
  student      User          @relation("LeaveStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User          @relation("LeaveReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  category     LeaveCategory
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  reason       String
  status       LeaveStatus   @default(SUBMITTED)
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([studentId])
  @@index([reviewerId, status])
}

// ---------------------------------------------------------------- employees, courses, games
model Employee {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  name        String
  designation String
  department  String
  email       String   @unique
  phone       String?
  joinedOn    DateTime @db.Date
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Semester {
  ODD
  EVEN
  SUMMER
}

model CourseRegistration {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseCode   String
  semester     Semester
  academicYear String
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([userId, courseCode, semester, academicYear])
}

model GameScore {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       String
  difficulty String   @default("normal")
  score      Int
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([game, difficulty, score])
  @@index([userId, game])
}

// ---------------------------------------------------------------- student community
enum PostTopic {
  ACADEMICS
  PROJECTS
  TECHNOLOGY
  CAMPUS_LIFE
  CLUBS
  CAREERS
  GENERAL
}

enum ContentStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum GroupKind {
  CLUB
  PROJECT_GROUP
}

enum JoinPolicy {
  OPEN
  REQUEST
}

enum GroupStatus {
  PUBLISHED
  ARCHIVED
}

// A student club or a project group. Not "official" until an administrator sets verified.
model Club {
  id          String      @id @default(uuid())
  name        String      @unique
  kind        GroupKind   @default(CLUB)
  category    PostTopic   @default(GENERAL)
  description String
  joinPolicy  JoinPolicy  @default(REQUEST)
  contactLink String?
  coverUrl    String?
  verified    Boolean     @default(false)
  status      GroupStatus @default(PUBLISHED)
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  members ClubMember[]
  posts   CommunityPost[]

  @@index([kind, status])
}

enum MemberRole {
  MEMBER
  MANAGER
}

enum MemberStatus {
  PENDING
  ACTIVE
}

model ClubMember {
  clubId    String
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole   @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  message   String?
  createdAt DateTime     @default(now())

  @@id([clubId, userId])
  @@index([userId])
}

model CommunityPost {
  id             String        @id @default(uuid())
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  clubId         String?
  club           Club?         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  topic          PostTopic     @default(GENERAL)
  title          String
  body           String
  isAnnouncement Boolean       @default(false)
  status         ContentStatus @default(VISIBLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  comments  CommunityComment[]
  likes     PostLike[]
  bookmarks PostBookmark[]

  @@index([status, createdAt])
  @@index([clubId, createdAt])
  @@index([topic])
}

model CommunityComment {
  id        String             @id @default(uuid())
  postId    String
  post      CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    CommunityComment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("Replies")
  body      String
  status    ContentStatus      @default(VISIBLE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([postId, createdAt])
}

model PostLike {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
}

model PostBookmark {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
}

enum ReportTarget {
  POST
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model ContentReport {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTarget
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  resolverId     String?
  resolver       User?        @relation("ReportResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  resolutionNote String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Chosen on the registration form. The account is always created as a student; staff access only changes
// when a super administrator approves the request.
model RoleRequest {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("RoleRequester", fields: [userId], references: [id], onDelete: Cascade)
  requestedRole Role
  status        RoleRequestStatus @default(PENDING)
  deciderId     String?
  decider       User?             @relation("RoleDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime          @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
  @@index([userId])
}
