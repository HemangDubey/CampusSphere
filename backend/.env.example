# Copy to backend/.env and never commit real values.
NODE_ENV=development
PORT=3000
# Comma-separated browser origins allowed to call the API cross-origin (leave empty for same-origin only).
CORS_ORIGINS=

# PostgreSQL connection string (server-side only). Neon example:
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/campussphere?schema=public

# Long random string (32+ chars) used to sign session cookies. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7
# lax for same-site hosting. Use "none" only for a cross-origin frontend over HTTPS.
COOKIE_SAMESITE=lax
# Max login/register/reset attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=10

# AI Assistant (server-side only; never exposed to the browser or the UI).
# Create a key in your provider console and paste it here, in backend/.env only.
GROQ_API_KEY=
# Model id used for replies. Change it here when a model is retired; no code change needed.
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=20000
# Max AI messages per signed-in user per minute.
AI_RATE_LIMIT_MAX=20
